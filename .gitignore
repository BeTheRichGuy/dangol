# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data
/data
/tests/shots
/.review

# 브레인스토밍 시안(로컬 전용)
.superpowers/

# python 캐시와 다시 만들 수 있는 소리 파일(3편 도트판)
__pycache__/
*.pyc
/reels/pixel/ep3/voice/*.wav
